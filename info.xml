<?xml version="1.0"?>
<extension key="org.civicrm.square" type="module">
  <file>square</file>
  <name>Square Payment Processor</name>
  <description>Integration with Square for payment processing</description>
  <license>AGPL-3.0-or-later</license>
  <maintainer>
    <author>
      <name>Skvare</name>
      <email>info@skvare.com</email>
      <role>Maintainer</role>
    </author>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/Skvare/org.civicrm.square</url>
    <url desc="Documentation">https://github.com/Skvare/org.civicrm.square#readme</url>
    <url desc="Support">https://github.com/Skvare/org.civicrm.square/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-10-08</releaseDate>
  <version>2.0.0-beta1</version>
  <develStage>beta</develStage>
  <compatibility mode="semver">
    <comments>Semantic versioning. For example, compatibility with "6.1" implies compatibility with "6.2".</comments>
    <ver>6.16</ver>
  </compatibility>
  <comments>Square payment processor for CiviCRM 6.16 and later. Stores card-on-file references via CiviCRM's native PaymentToken entity and Square customer mappings in an extension-owned square_customer_map table (see CRM_Square_Upgrader).</comments>
  <requires>
    <ext>mjwshared</ext>
    <ext>civi_contribute</ext>
  </requires>
  <civix>
    <namespace>CRM/Square</namespace>
    <format>25.10.2</format>
  </civix>
  <upgrader>CRM_Square_Upgrader</upgrader>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>mgd-php@1.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
  </classloader>
</extension>
