{
  "name": "skvare/org.civicrm.square",
  "description": "Square payment processor integration for CiviCRM",
  "type": "civicrm-extension",
  "homepage": "https://github.com/Skvare/org.civicrm.square",
  "extra": {
    "civicrm": {
      "type": "payment"
    }
  },
  "license": "AGPL-3.0-or-later",
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true,
    "prepend-autoloader": false,
    "optimize-autoloader": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "authors": [
    {
      "name": "Skvare",
      "email": "info@skvare.com"
    }
  ],
  "support": {
    "issues": "https://github.com/Skvare/org.civicrm.square/issues",
    "source": "https://github.com/Skvare/org.civicrm.square"
  },
  "require": {
    "php": ">=8.2",
    "nyholm/psr7": "^1.8",
    "square/square": "^47.0",
    "symfony/http-client": "^7.4"
  }
}
